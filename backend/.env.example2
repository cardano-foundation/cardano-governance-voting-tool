# IPFS preconfigs: a JSON array of pre-configured IPFS providers the frontend
# It’s written in a single line to be compatible with how docker-compose loads it
IPFS_PRECONFIGS_JSON=[{"id":"default","label":"Pre-configured IPFS server","description":"Files will be stored using the pre-configured IPFS servers.","format":"basic","rpcUrl":"https://ipfs-rpc.mycompany.org/api/v0","userId":"user","password":"password"}]

# Network config: 0 for Preview, 1 for Mainnet
NETWORK_ID=0
